{
  "name": "web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "author": "moonsong-labs",
  "license": "(MIT OR Apache-2.0)",
  "scripts": {
    "build": "run-s build:*",
    "build:remix": "remix vite:build",
    "build:server": "tsx esbuild.ts",
    "dev": "NODE_ENV=development FORCE_COLOR=true tsx watch --clear-screen=false --ignore \".cache/**\" --ignore \"app/**\" --ignore \"vite.config.ts.timestamp-*\" --ignore \"build/**\" --ignore \"node_modules/**\" -r dotenv/config --inspect ./server/index.ts | pino-pretty",
    "start": "node ./server-build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "run-s test:u test:s test:tx-sim",
    "test:u": "vitest run --config ./vitest.unit.config.ts",
    "test:s": "vitest run --config ./vitest.server.config.ts",
    "test:i": "vitest run --config ./vitest.integration.config.ts",
    "test:fork": "vitest run --config ./vitest.fork.config.ts",
    "test:tx-sim": "node --test standalone/tx-sim/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "=1.1.4",
    "@radix-ui/react-label": "=2.1.1",
    "@radix-ui/react-progress": "=1.1.1",
    "@radix-ui/react-separator": "=1.1.1",
    "@radix-ui/react-slot": "=1.1.1",
    "@rainbow-me/rainbowkit": "=2.2.2",
    "@remix-run/express": "=2.16.0",
    "@remix-run/node": "=2.16.0",
    "@remix-run/react": "=2.16.0",
    "@repo/common": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@t3-oss/env-core": "=0.10.1",
    "@tanstack/react-query": "=5.55.4",
    "address": "=2.0.3",
    "chalk": "=5.3.0",
    "class-variance-authority": "=0.7.0",
    "close-with-grace": "=1.3.0",
    "clsx": "=2.1.1",
    "compression": "=1.7.4",
    "dotenv": "^16.4.5",
    "express": "=4.21.2",
    "express-rate-limit": "=7.3.1",
    "get-port": "=7.1.0",
    "isbot": "=4.4.0",
    "lucide-react": "=0.399.0",
    "pino": "=9.2.0",
    "pino-http": "=10.2.0",
    "react": "=19.0.0",
    "react-dom": "=19.0.0",
    "react-hot-toast": "=2.5.1",
    "react-router-dom": "6.30.0",
    "tailwind-merge": "=2.6.0",
    "tailwindcss-animate": "=1.0.7",
    "viem": "=2.22.9",
    "wagmi": "=2.14.8",
    "zod": "=3.24.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.16.0",
    "@testing-library/dom": "^10.3.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.23.1",
    "esbuild-node-externals": "^1.14.0",
    "ethers": "5.7.2",
    "jsdom": "^24.1.0",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^11.2.1",
    "postcss": "^8.4.39",
    "remix-flat-routes": "^0.6.5",
    "remix-routes": "^1.7.6",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
