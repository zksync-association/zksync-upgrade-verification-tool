{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "server-build/**"]
    },
    "typecheck": {},
    "web#typecheck": {
      "dependsOn": ["web#build"]
    },
    "test": {}
  },
  "globalPassThroughEnv": ["SKIP_ENV_VALIDATION"]
}
